# --- Required ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key        # server-only, never exposed to the browser
GEMINI_API_KEY=your-google-ai-studio-key
ADMIN_PASSCODE=pick-a-passcode                         # protects /api/admin/* and /api/pipeline (send as x-admin-key); the dashboard needs no login
CRON_SECRET=pick-a-long-random-string                  # Vercel sends this to the cron routes

# --- Gemini (all AI runs on Gemini Flash) ---
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash                 # used automatically if the first model is unavailable on your key
GEMINI_CONCURRENCY=2

# --- Recommended for reliable live data from Vercel's servers ---
STACKEXCHANGE_KEY=                                     # free: https://stackapps.com/apps/oauth/register (300 -> 10,000 requests/day)
REDDIT_CLIENT_ID=                                      # free "script" app: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=web:devcommpulse:v1.0 (by /u/your_username)

# --- Optional delivery of the Friday brief ---
APP_URL=https://devcommpulse.vercel.app
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
DIGEST_EMAIL_TO=sumit@example.com
DIGEST_EMAIL_FROM=Pulse <pulse@yourdomain.com>
